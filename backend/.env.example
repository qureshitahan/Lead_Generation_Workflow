# =============================================================================
# Lead Generation Workflow - Backend Environment
# Copy this file to `.env` and fill in keys as you obtain them.
# Everything works with stub/mock providers until real keys are provided.
# =============================================================================

# --- Core app ---
APP_NAME="Lead Generation Workflow"
ENVIRONMENT=development
# SQLite by default. Swap to postgresql+psycopg://user:pass@host/db for production.
DATABASE_URL=sqlite:///./data/leadgen.db
# Comma-separated list of origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Target roles the recruiter cares about (drives relevance scoring) ---
# Comma-separated. Used as defaults; can be overridden per-import later.
TARGET_ROLES=Software Engineer,AI Engineer,Machine Learning Engineer,Data Engineer

# --- Job data sources (Milestone 1 uses file import; keys optional) ---
BRIGHTDATA_API_KEY=
APIFY_API_TOKEN=

# --- Company / contact enrichment (Milestone 3) ---
# Provider options: stub | apollo | zoominfo
ENRICHMENT_PROVIDER=stub
APOLLO_API_KEY=
ZOOMINFO_API_KEY=

# --- Email sending (Milestone 4) ---
# Provider options: stub | postmark | sendgrid
EMAIL_PROVIDER=stub
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
OUTREACH_FROM_EMAIL=outreach@example.com
OUTREACH_FROM_NAME=Your Recruiting Team

# --- Voice calling (Milestone 4) ---
# Provider options: stub | twilio_elevenlabs
VOICE_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=

# --- Optional LLM for smarter classification / drafting (falls back to rules) ---
# Provider options: none | openai
LLM_PROVIDER=none
OPENAI_API_KEY=

# --- Safety / compliance ---
# Max outreach attempts per company before requiring manual override.
MAX_OUTREACH_PER_COMPANY=3
# Cooldown days before contacting the same company again.
OUTREACH_COOLDOWN_DAYS=14
